<idea-plugin>
    <id>com.mms.mms-language</id>
    <name>MMS Language</name>
    <vendor email="" url="">MMS</vendor>
    <version>0.1.0</version>

    <description><![CDATA[
        Basic MMS language support: recognizes .mms files as MMS.
        This is a minimal plugin scaffold that can be extended with syntax highlighting and LSP.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Register MMS file type for *.mms -->
        <fileType name="MMS"
                  language="MMS"
                  extensions="mms"
                  implementationClass="com.mms.idea.MmsFileType"/>
    </extensions>
</idea-plugin>
