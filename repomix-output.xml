import { it } from "bun:test";
import { parseExpression } from "./noise";
import { Listener } from "./visitor";
import { ParseTreeWalker } from "antlr4";

it("should work?", () => {
    const tree = parseExpression(`density:noise MyNoise {
        noise minecraft:noodle
        xz_scale 1
        y_scale 1
    }
    `);
    if (tree.exception) {
        console.log(tree.exception?.message)
        console.log(`Test@${tree.exception?.offendingToken?.line}:${tree.exception?.offendingToken?.column}-${tree.exception?.offendingToken?.stop}`)
    } else {
        new ParseTreeWalker().walk(new Listener(), tree)
    }
})
