{
  "Bedrock": {
    "type": "minecraft:block",
    "block": "minecraft:bedrock"
  },
  "DiamondBlocks": {
    "type": "minecraft:block",
    "block": "minecraft:diamond_block"
  },
  "Entrypoint": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:conditional",
        "if_true": {
          "type": "minecraft:biome",
          "biomes": [
            "minecraft:plains",
            "minecraft:forest",
            "minecraft:river",
            "minecraft:beach",
            "minecraft:flower_forest",
            "minecraft:sunflower_plains"
          ]
        },
        "then_run": {
          "type": "minecraft:block",
          "block": "minecraft:diamond_block"
        }
      },
      {
        "type": "minecraft:block",
        "block": "minecraft:bedrock"
      }
    ]
  }
}
