{
  "MegaRule": {
    "type": "minecraft:conditional",
    "if_true": {
      "type": "minecraft:noise",
      "noise": "minecraft:weird",
      "min_threshold": 0.1,
      "max_threshold": 0.9
    },
    "then_run": {
      "type": "minecraft:not",
      "invert": {
        "type": "minecraft:conditional",
        "if_true": {
          "type": "minecraft:temperature"
        },
        "then_run": {
          "type": "minecraft:conditional",
          "if_true": {
            "type": "minecraft:biome",
            "biomes": [
              "minecraft:plains",
              "minecraft:mountains"
            ]
          },
          "then_run": {
            "type": "minecraft:conditional",
            "if_true": {
              "type": "minecraft:hole"
            },
            "then_run": {
              "type": "minecraft:block",
              "block": "minecraft:stone"
            }
          }
        }
      }
    }
  }
}
